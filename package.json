{
  "name": "cardcascade",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "CardCascade: SprintSense Kanban board and sprint planner (React + Express)",
  "scripts": {
    "dev": "concurrently -n web,api \"vite\" \"node server/index.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "vite build && node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
